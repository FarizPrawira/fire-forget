{
  "name": "fire-forget",
  "version": "0.1.0",
  "description": "Tiny, zero-dependency in-flight promise tracker with drain-on-shutdown and AbortSignal cancellation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "verify": "npm run typecheck && npm test && npm run build",
    "preversion": "npm run verify",
    "postversion": "git push --follow-tags",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "fire-and-forget",
    "promise",
    "graceful-shutdown",
    "drain"
  ],
  "author": "Fariz Prawira <farizprawira94@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarizPrawira/fire-forget.git"
  },
  "bugs": {
    "url": "https://github.com/FarizPrawira/fire-forget/issues"
  },
  "homepage": "https://github.com/FarizPrawira/fire-forget#readme",
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.6"
  }
}
